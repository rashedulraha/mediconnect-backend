model Payment {
  id                    String        @id @default(uuid())
  status                PaymentStatus @default(UNPAID)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("BDT")
  paymentGateway        String        @default("Bkash")
  merchantInvoiceNumber String        @unique
  bkashPaymentId        String?       @unique
  bkashTRXId            String?       @unique
  payerReference        String? // email and phone number
  paidAt                String?
  gatewayResponse       Json?

  refundTrxId  String?
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundAt     DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("payments")
}
